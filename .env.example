# ---- Django core_api ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (default). Swap for a MySQL URL, e.g.
# DATABASE_URL=mysql://user:password@mysql:3306/orbit
DATABASE_URL=postgres://orbit:orbit@postgres:5432/orbit

# Redis (cache, Channels layer, Celery broker/result backend)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ORDER_EVENTS_TOPIC=order-events
KAFKA_INVENTORY_EVENTS_TOPIC=inventory-events
KAFKA_CONSUMER_GROUP=notification-service

# Auth
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
OAUTH2_ENABLED=True

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- notification_service (FastAPI) ----
NOTIF_SERVICE_NAME=notification-service
NOTIF_HTTP_PORT=8001
NOTIF_REDIS_URL=redis://redis:6379/3
NOTIF_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
NOTIF_KAFKA_TOPICS=order-events,inventory-events
NOTIF_KAFKA_CONSUMER_GROUP=notification-service
NOTIF_SENTRY_DSN=
